# Campus Lost & Found — Environment Variables
# Copy this file to .env and fill in values.

# Flask session secret key (REQUIRED for production — generate a random string)
SECRET_KEY=change-me-to-a-random-secret-string

# Database URL (REQUIRED for Vercel production — SQLite is ephemeral on serverless)
# For local dev: leave unset (uses local SQLite file)
# For production: set to a PostgreSQL connection string
#   e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# CORS origins (comma-separated, leave empty for dev defaults)
# e.g. https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Cloudinary (used for persistent image storage in production)
# Uploaded images are stored in Cloudinary and the secure_url is kept in the DB.
# When these are unset, uploads fall back to the local filesystem (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
